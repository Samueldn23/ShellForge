{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "version": 4,
  "final_space": true,
  "console_title_template": "{{if .Root}}(Admin) {{end}}{{.Folder}}",
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "type": "root",
          "style": "powerline",
          "powerline_symbol": "\ue0c4",
          "background": "#f1184c",
          "foreground": "#242424",
          "template": "{{ if .Root }}\uf0e7 Admin {{ else }}\uf0e7{{ end }}"
        },
        {
          "type": "os",
          "style": "diamond",
          "leading_diamond": "",
          "background": "#282c34",
          "foreground": "#3A86FF",
          "template": "{{ if .WSL }}WSL at {{ end }}{{.Icon}} {{ .OS }} "
        },
        {
          "type": "session",
          "style": "powerline",
          "powerline_symbol": "\ue0c4",
          "background": "#242424",
          "foreground": "#00D7AF",
          "template": " \uf110 {{ if .SSHSession }}{{ .UserName }}@{{ .HostName }}{{ end }}"
        },
        {
          "type": "time",
          "style": "powerline",
          "powerline_symbol": "\ue0c4",
          "background": "#242424",
          "foreground": "#FFBB00",
          "properties": {
            "time_format": "15:04:05"
          },
          "template": "{{ .CurrentDate | date .Format }}"
        },
        {
          "type": "path",
          "style": "powerline",
          "powerline_symbol": "\ue0c4",
          "background": "#342828",
          "foreground": "#33DD2D",
          "properties": {
            "folder_separator_icon": "/",
            "home_icon": "\uf015",
            "style": "full"
          },
          "template": "<#f2f200>\ue5ff </>{{ .Path }} "
        },
        {
          "type": "python",
          "style": "powerline",
          "powerline_symbol": "\ue0c4",
          "background": "#4c1f5e",
          "foreground": "#f2f200",
          "properties": {
            "time_format": "15:04:05"
          },
          "template": " \ue235 {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }}"
        },
        {
          "type": "git",
          "style": "diamond",
          "background": "#282c34",
          "foreground": "#3A86FF",
          "foreground_templates": [
            "{{ if or (.Working.Changed) (.Staging.Changed) }}#ffeb3b{{ end }}",
            "{{ if gt .Ahead 0 }}#2EC4B6{{ end }}",
            "{{ if gt .Behind 0 }}#8A4FFF{{ end }}"
          ],
          "properties": {
            "fetch_stash_count": true,
            "fetch_status": true,
            "fetch_upstream_icon": true
          },
          "template": " {{ .UpstreamIcon }}{{ .HEAD }}{{if .BranchStatus }} {{ .BranchStatus }}{{ end }}{{ if .Working.Changed }}<#E84855> \uf044 {{ .Working.Added }}{{ if gt .Working.Untracked 0 }} \uf055 {{ .Working.Untracked }}{{ end }}</>{{ end }}{{ if and (.Working.Changed) (.Staging.Changed) }} |{{ end }}{{ if .Staging.Changed }}<#2FDA4E> \uf046 {{ .Staging.String }}</>{{ end }}{{ if gt .StashCount 0 }} \ueb4b {{ .StashCount }}{{ end }} "
        },
        {
          "type": "dotnet",
          "style": "powerline",
          "powerline_symbol": "\ue0c4",
          "background": "#0184bc",
          "foreground": "#ffffff",
          "template": " \ue70c {{ if .Unsupported }}\uf071{{ else }}{{ .Full }}{{ end }} "
        },
        {
          "type": "go",
          "style": "powerline",
          "powerline_symbol": "\ue0c4",
          "background": "#4c1f5e",
          "foreground": "#7FD5EA",
          "properties": {
            "fetch_version": true
          },
          "template": " \ue626 {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }} "
        },
        {
          "type": "node",
          "style": "powerline",
          "powerline_symbol": "\ue0c4",
          "background": "#6a0dad",
          "foreground": "#42E66C",
          "properties": {
            "fetch_version": true
          },
          "template": " \ue718 {{ if .PackageManagerIcon }}{{ .PackageManagerIcon }} {{ end }}{{ .Full }} "
        },
        {
          "type": "ruby",
          "style": "powerline",
          "powerline_symbol": "\ue0c4",
          "background": "#4c1f5e",
          "foreground": "#E64747",
          "properties": {
            "fetch_version": true
          },
          "template": " \ue791 {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }} "
        },
        {
          "type": "java",
          "style": "powerline",
          "powerline_symbol": "\ue0c4",
          "background": "#4c1f5e",
          "foreground": "#E64747",
          "properties": {
            "fetch_version": true
          },
          "template": " \ue738 {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }} "
        },
        {
          "type": "dart",
          "style": "powerline",
          "powerline_symbol": "\ue0c4",
          "background": "#4c1f5e",
          "foreground": "#42A5F5",
          "properties": {
            "fetch_version": true
          },
          "template": " \ue798 {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }} "
        },
        {
          "type": "flutter",
          "style": "powerline",
          "powerline_symbol": "\ue0c4",
          "background": "#242424",
          "foreground": "#46B5E7",
          "template": " \uebe4 {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }} "
        },
        {
          "type": "lua",
          "style": "powerline",
          "powerline_symbol": "\ue0c4",
          "background": "#4c1f5e",
          "foreground": "#51A0CF",
          "properties": {
            "fetch_version": true
          },
          "template": " \ue620 {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }} "
        },
        {
          "type": "rust",
          "style": "powerline",
          "powerline_symbol": "\ue0c4",
          "background": "#4c1f5e",
          "foreground": "#F74C00",
          "properties": {
            "fetch_version": true
          },
          "template": " \ue7a8 {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }} "
        },
        {
          "type": "kubectl",
          "style": "powerline",
          "powerline_symbol": "\ue0c4",
          "background": "#242424",
          "foreground": "#326CE5",
          "template": " \uf046 {{ .Context }}{{ if .Namespace }} :: {{ .Namespace }}{{ end }}"
        },
        {
          "type": "project",
          "style": "powerline",
          "powerline_symbol": "\ue0c4",
          "background": "#242424",
          "foreground": "#f1184c",
          "template": " \uf0ad {{ if .Error }}{{ .Error }}{{ else }}{{ .Name }}{{ if .Version }} ({{ .Version }}){{ end }}{{ end }} "
        },
        {
          "type": "executiontime",
          "style": "powerline",
          "powerline_symbol": "\ue0c4",
          "background": "#8800dd",
          "foreground": "#ffffff",
          "properties": {
            "style": "austin",
            "threshold": 500
          },
          "template": " <#fefefe>\ueba2</> {{ .FormattedMs }} "
        },
        {
          "type": "status",
          "style": "powerline",
          "powerline_symbol": "\ue0b4",
          "background": "#33DD2D",
          "background_templates": [
            "{{ if gt .Code 0 }}#f1184c{{ end }}"
          ],
          "foreground": "#242424",
          "template": " \ueb05 "
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "type": "text",
          "style": "plain",
          "foreground": "#f1184c",
          "template": "\u279c "
        }
      ]
    }
  ],
  "transient_prompt": {
    "background": "transparent",
    "foreground": "#f1184c",
    "template": "\u279c "
  }
}
