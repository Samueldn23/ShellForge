[core]
	editor = code --wait
	fsmonitor = true
	pager = delta
[safe]
	directory = D:/USER/Dev/traduzir_csv
	directory = A:/Desenvolvimento/Retail_S
[windows]
	appendAtomically = false
[credential "helperselector"]
